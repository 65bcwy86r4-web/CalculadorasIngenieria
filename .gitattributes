# Normaliza los finales de linea al guardar en el repositorio.
# Sin esto, editar un archivo en Windows lo marca entero como modificado por el
# cambio de LF a CRLF, y los diffs se vuelven ilegibles.
* text=auto eol=lf

# Archivos que Windows necesita con CRLF si o si.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binarios: git no los toca.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.zip binary
